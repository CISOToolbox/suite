# ── CISO Toolbox — Environment Variables ─────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Domain & URL ─────────────────────────────────────────────
# For local dev: https://localhost
# For production: https://ciso.yourdomain.com
APP_URL=https://localhost

# ── Database ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 16  (setup.sh does this for you)
DB_PASSWORD=change-me-generate-with-openssl-rand-hex-16

# ── Security ─────────────────────────────────────────────────
# Authentication mode (default: pilot):
#   pilot      — suite-integrated, JWT cookie issued by Pilot (needs JWT_SECRET)
#   standalone — module's own login flow (needs AUTH_TOKEN)
#   none       — AUTH DISABLED, every route served as admin. DEV/TEST ONLY.
# Fail-closed: with any mode other than `none`, an empty credential makes the
# modules REFUSE TO START (no more silent unauthenticated-admin in production).
# To run without auth in dev/recette, set this explicitly:
# AUTH_MODE=none
#
# Generate each with: openssl rand -hex 32
#
# JWT_SECRET is a ROOT secret, not a signing key: each module signs and
# verifies with its own key, derived as
#   HKDF-SHA256(JWT_SECRET, info="ciso-module:<module>")
# so a compromised module cannot forge sessions for the other ones. Nothing
# to configure — the derivation happens at startup. Changing this value
# rotates every module key at once and logs every user out.
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
SERVICE_TOKEN=change-me-generate-with-openssl-rand-hex-32
# Data-at-rest key for connector credentials / repo tokens (asset, access,
# appsec, watch). REQUIRED — the compose refuses to start without it (no more
# silent fallback to JWT_SECRET, which coupled the session-forgery and
# data-at-rest trust domains). Use a DEDICATED value distinct from JWT_SECRET.
# Must be >= 32 chars. Rotating it requires re-encrypting stored secrets.
ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# Session lifetime in hours (default 24). The session JWT is stateless — it
# cannot be revoked before it expires — so this is the upper bound on how long
# a user deleted or downgraded in Pilot keeps access to the modules. Lower it
# (e.g. 8, or 4 for high-sensitivity deployments) to shrink that window, at the
# cost of more frequent re-authentication. Clamped to 1..168; the same variable
# governs every module (standalone included).
JWT_EXPIRY_HOURS=24

# ── Entra ID (Azure AD) — Single app for all modules ────────
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=common

# ── Google OAuth (optional) ──────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Generic OIDC (optional) ──────────────────────────────────
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_LABEL=SSO

# ── AI API Keys (optional) ──────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Surface SMB file-share add-on (optional) ────────────────
# Service account used by the smb_scan_rs add-on to read file shares.
# Only relevant when that add-on is baked into the Surface image.
# Never stored in the DB — read from the environment at scan time.
SURFACE_SMB_USERNAME=
SURFACE_SMB_PASSWORD=
SURFACE_SMB_DOMAIN=

# ── Connecteurs Access ─────────────────────────────────────────
# Autoriser une URL de base de connecteur sur une adresse privee
# (RFC1918). A ne mettre a true que si le deploiement a reellement des
# connecteurs on-prem : GitLab ou Keycloak auto-heberges, annuaire LDAP.
# Les conteneurs de la suite (pilot-app, risk-db, ...) et tous les points
# de metadonnees cloud restent refuses dans les deux cas.
ALLOW_PRIVATE_CONNECTOR_URLS=false

# pgBackRest repository encryption (FEAT-30 — PITR backups).
# The backups repo volume is encrypted at rest with this passphrase.
# LOSING IT MAKES EVERY BACKUP UNREADABLE — store it in your vault.
# Generate with: openssl rand -hex 32  (setup.sh does this for you)
BACKUP_CIPHER_PASS=change-me-generate-with-openssl-rand-hex-32

# Recovery API token (FEAT-30 phase 2) — shared between Pilot and the
# backup agent only. It is the ONLY control on an API that can drop and
# recreate a live database, and it is reachable from every container on the
# compose network — treat it like a root password.
# Generate with: openssl rand -hex 32  (setup.sh does this for you)
BACKUP_AGENT_TOKEN=change-me-generate-with-openssl-rand-hex-32

# FEAT-31 — à-la-carte composition. When set (e.g. "risk,compliance"), Pilot's
# registry — dashboard, backups, restore, config pushes AND the module-switcher
# menu of every app — is restricted to this subset. Keep in sync with the
# services actually deployed in docker-compose.yml. Empty = full suite.
PILOT_MODULES=

# Base URL publique de la suite (liens absolus dans les emails du digest
# d'échéances, ex. https://suite.example.com). Vide = liens relatifs.
PUBLIC_BASE_URL=
