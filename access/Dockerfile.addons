# Client add-on overlay — layers selected add-on connectors on top of a core
# Access image. Built by shared/build-client-image.sh, which stages the chosen
# addons into .client-addons/ (build context). NOT used by the suite image.
#
#   BASE = a core Access image (e.g. ciso-access:local, or a pinned
#          ghcr.io/cisotoolbox/ciso-access-suite:vX.Y.Z for releases).
ARG BASE=ciso-access:local
FROM ${BASE}

USER root
COPY .client-addons/ /app/addons/
# Install each add-on's own Python deps (e.g. openpyxl for spreadsheet parsing).
RUN find /app/addons -name requirements.txt -exec pip install --no-cache-dir -r {} \; \
    && chown -R appuser:appuser /app/addons
USER appuser

ENV ACCESS_ADDON_PATHS=/app/addons
